{
  "appId": "br.com.eduit.crm",
  "appName": "Bwipo",
  "webDir": "www",
  "server": {
    "url": "https://bwipo.com/",
    "hostname": "bwipo.com",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "bwipo.com",
      "www.bwipo.com",
      "*.bwipo.com",
      "localhost",
      "127.0.0.1",
      "www.facebook.com",
      "m.facebook.com",
      "facebook.com",
      "*.facebook.com",
      "web.facebook.com",
      "www.instagram.com",
      "instagram.com",
      "*.instagram.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0d1b3e"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0d1b3e",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0d1b3e"
    }
  }
}
